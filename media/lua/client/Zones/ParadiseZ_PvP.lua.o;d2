ParadiseZ = ParadiseZ or {}
function ParadiseZ.isPvpInvalid(char)
    char = char or getPlayer() 
    local isHasPveTrait = ParadiseZ.isPvE(char)
    local isHasPveZone = ParadiseZ.isPveZone(char)
    return isHasPveTrait or isHasPveZone
end
function ParadiseZ.isUnarmed(pl)
	return tostring(WeaponType.getWeaponType(pl)) == 'barehand'
end

function ParadiseZ.getPvpWpnDmg(wpn, char)
    char = char or getPlayer()
    local wpnDmg = 0

    if ParadiseZ.isUnarmed(char) then
        return 0
    end

    wpn = wpn or char:getPrimaryHandItem()
    if not wpn then
        return SandboxVars.ParadiseZpvp.MeleePvpDmg or 10
    end

    local item = ScriptManager.instance:getItem(wpn:getFullType())
    local isMeleeAttack = char:IsInMeleeAttack()
    if not item or not item:isRanged() or isMeleeAttack then
        return SandboxVars.ParadiseZpvp.MeleePvpDmg or 10
    end

    if item.getSwingAnim and item:getSwingAnim() == "Rifle" then
        local shotgunTable = ParadiseZ.getShotgunTable()
        if shotgunTable[wpn:getFullType()] then
            wpnDmg = SandboxVars.ParadiseZpvp.ShotgunPvpDmg or 25
        else
            wpnDmg = SandboxVars.ParadiseZpvp.RiflePvpDmg or 20
        end
    else
        wpnDmg = SandboxVars.ParadiseZpvp.PistolPvpDmg or 15
    end

    return wpnDmg
end





function ParadiseZ.pvpHit(char, targ, wpn, damage)
    local isAvoid = true
    local isHasPveTrait = ParadiseZ.isPvE(char) or ParadiseZ.isPvE(targ)
    local isHasPveZone = ParadiseZ.isPveZone(char) or ParadiseZ.isPveZone(targ)
    local isHasZed = instanceof(char, 'IsoZombie') or instanceof(targ, 'IsoZombie')
    local pvpDmg = true

    local isFirearm = ParadiseZ.isFirearm(wpn)

    if isHasPveTrait or isHasPveZone then
        pvpDmg = false
    end

    if isHasZed then
        isAvoid = false
        pvpDmg = false
    end
    targ:setAvoidDamage(isAvoid)   
    local bonus = 0
    local isCrit = targ:isCriticalHit() 
    if isCrit then
        bonus = ZombRand(0, SandboxVars.ParadiseZpvp.pvpDmgMult + 1)
    end
    
    if pvpDmg and targ == getPlayer() then
        local dmg = ParadiseZ.getPvpWpnDmg(wpn, char)
        local md = targ:getModData()
        local lowest = 0
        if targ:isGodMod() then lowest = 1 end
        md.LifePoints = math.max(lowest, (md.LifePoints or 100) - (dmg+bonus))
        md.LifeBarFlash = 0.4
        if ParadiseZ.doRoll(SandboxVars.ParadiseZpvp.PvPInjuryChance) and isFirearm then
            if not targ:HasTrait('InjuredPvP') then
                targ:getTraits():add('InjuredPvP')
                targ:addLineChatElement('PvP Injured')
            end
        end

        if md.LifePoints <= 0 then
            if not SandboxVars.ParadiseZpvp.teleportPvpDeath then   
                targ:Kill(char)
            end    
        end
    end
end
Events.OnWeaponHitCharacter.Remove(ParadiseZ.pvpHit)
Events.OnWeaponHitCharacter.Add(ParadiseZ.pvpHit)

function ParadiseZ.pvpHeal(player, context, items)
    local pl = getSpecificPlayer(player)
    if not pl then return end

    local item

    if instanceof(items, "InventoryItem") then
        if items:getFullType() == "ParadiseZ.MedkitPvP" then
            item = items
        end
    else
        for i=1,#items do
            local entry = items[i]
            local it = entry
            if type(entry) == "table" and entry.items then
                it = entry.items[1]
            end
            if it and it:getFullType() == "ParadiseZ.MedkitPvP" then
                item = it
                break
            end
        end
    end

    if not item then return end
    if not pl:getInventory():contains(item) then return end
    
    local opt = context:addOption("Apply PvP Medkit", item, function(it)
        ISTimedActionQueue.add(ISApplyMedkitPvP:new(pl, it))
    end)
    local md = pl:getModData()
    if not pl:HasTrait("InjuredPvP") and md.LifePoints >= 100 then
        opt.notAvailable = true
        local tt = ISToolTip:new()
        tt:initialise()
        tt:setVisible(false)
        tt.description = "You are not Injured"
        opt.toolTip = tt
    end
end
Events.OnFillInventoryObjectContextMenu.Add(ParadiseZ.pvpHeal)


local function _pzSafeCall(obj, methodName, ...)
    if obj and obj[methodName] then
        pcall(obj[methodName], obj, ...)
    end
end

function ParadiseZ._snapshotExplosionHealth(pl)
    if not pl then return nil end

    local body = pl:getBodyDamage()
    if not body then return nil end

    local snap = {
        overall = body:getOverallBodyHealth(),
        infectionLevel = body:getInfectionLevel(),
        fakeInfectionLevel = body:getFakeInfectionLevel(),
        foodSicknessLevel = body:getFoodSicknessLevel(),
        infected = body:IsInfected(),
        fakeInfected = body:IsFakeInfected(),
        onFire = body:IsOnFire(),
        parts = {}
    }

    local bodyParts = body:getBodyParts()
    if bodyParts then
        for i = 0, bodyParts:size() - 1 do
            local part = bodyParts:get(i)
            if part then
                local key = tostring(part:getType())
                snap.parts[key] = {
                    bandaged = part:bandaged(),
                    stitched = part:stitched(),
                    splintFactor = part:getSplintFactor(),
                    additionalPain = part:getAdditionalPain(),
                    stiffness = part:getStiffness(),
                    scratchTime = part:getScratchTime(),
                    cut = part:isCut(),
                    cutTime = part.getCutTime and part:getCutTime() or 0,
                    deepWounded = part:isDeepWounded(),
                    deepWoundTime = part:getDeepWoundTime(),
                    bitten = part:bitten(),
                    infectedWound = part:isInfectedWound(),
                    fakeInfected = part:IsFakeInfected(),
                    bleedingTime = part:getBleedingTime(),
                    haveBullet = part:haveBullet(),
                    haveGlass = part:haveGlass(),
                    fractureTime = part:getFractureTime(),
                    burnTime = part:getBurnTime()
                }
            end
        end
    end

    return snap
end

function ParadiseZ._restoreExplosionHealth(pl, snap)
    if not pl or not snap then return end

    local body = pl:getBodyDamage()
    if not body then return end

    if snap.overall then
        body:AddGeneralHealth(snap.overall - body:getOverallBodyHealth())
    end
    if snap.infectionLevel ~= nil then body:setInfectionLevel(snap.infectionLevel) end
    if snap.fakeInfectionLevel ~= nil then body:setFakeInfectionLevel(snap.fakeInfectionLevel) end
    if snap.foodSicknessLevel ~= nil then body:setFoodSicknessLevel(snap.foodSicknessLevel) end
    if snap.infected ~= nil then body:setInfected(snap.infected) end
    if snap.fakeInfected ~= nil then body:setIsFakeInfected(snap.fakeInfected) end
    if snap.onFire ~= nil then body:setIsOnFire(snap.onFire) end

    local bodyParts = body:getBodyParts()
    if not bodyParts then return end

    for i = 0, bodyParts:size() - 1 do
        local part = bodyParts:get(i)
        if part then
            local saved = snap.parts[tostring(part:getType())]
            if saved then
                _pzSafeCall(part, "setBandaged", saved.bandaged == true)
                _pzSafeCall(part, "setStitched", saved.stitched == true)
                _pzSafeCall(part, "setSplintFactor", saved.splintFactor or 0)
                _pzSafeCall(part, "setAdditionalPain", saved.additionalPain or 0)
                _pzSafeCall(part, "setStiffness", saved.stiffness or 0)

                if (saved.scratchTime or 0) > 0 then
                    _pzSafeCall(part, "setScratched", true, true)
                    _pzSafeCall(part, "setScratchTime", saved.scratchTime)
                else
                    _pzSafeCall(part, "setScratched", false, false)
                    _pzSafeCall(part, "setScratchTime", 0)
                end

                _pzSafeCall(part, "setCut", saved.cut == true)
                if saved.cut == true then
                    _pzSafeCall(part, "setCutTime", saved.cutTime or 0)
                else
                    _pzSafeCall(part, "setCutTime", 0)
                end

                _pzSafeCall(part, "setDeepWounded", saved.deepWounded == true)
                _pzSafeCall(part, "setDeepWoundTime", saved.deepWoundTime or 0)
                _pzSafeCall(part, "SetBitten", saved.bitten == true)
                _pzSafeCall(part, "SetInfected", saved.infectedWound == true)
                _pzSafeCall(part, "SetFakeInfected", saved.fakeInfected == true)
                _pzSafeCall(part, "setBleedingTime", saved.bleedingTime or 0)
                _pzSafeCall(part, "setHaveBullet", saved.haveBullet == true, 0)
                _pzSafeCall(part, "setHaveGlass", saved.haveGlass == true)
                _pzSafeCall(part, "setFractureTime", saved.fractureTime or 0)
                _pzSafeCall(part, "setBurnTime", saved.burnTime or 0)
            end
        end
    end
end

function ParadiseZ._restoreExplosionProtectionAfterTicks(pl, snap, ticks, token)
    ticks = ticks or 3
    local function tickHook()
        ticks = ticks - 1
        if ticks <= 0 then
            Events.OnTick.Remove(tickHook)
            if pl then
                ParadiseZ._restoreExplosionHealth(pl, snap)
                local md = pl:getModData()
                if not token or md.PZExplosionProtectToken == token then
                    pl:setAvoidDamage(false)
                    md.PZExplosionProtectToken = nil
                end
            end
        end
    end
    Events.OnTick.Add(tickHook)
end

function ParadiseZ._applyExplosionPvpDamage(pl, boomSq, baseDmg, rad)
    if not pl or not boomSq or not baseDmg or not rad or rad <= 0 then return end
    if ParadiseZ.isPvE(pl) or ParadiseZ.isPveZone(pl) then return end

    local checkDist = ParadiseZ.checkDist(pl, boomSq)
    if not checkDist or checkDist > rad then return end

    local dmg = math.max(0, math.floor(tonumber(baseDmg) or 0))
    local reduced = math.floor(dmg * checkDist / math.max(1, rad))
    local minDmg = math.max(0, dmg - reduced)
    if dmg > minDmg then
        dmg = ZombRand(minDmg, dmg + 1)
    else
        dmg = minDmg
    end

    local md = pl:getModData()
    local lowest = 0
    if pl:isGodMod() then lowest = 1 end
    md.LifePoints = math.max(lowest, (md.LifePoints or 100) - dmg)
    md.LifeBarFlash = 0.4

    if ParadiseZ.doRoll(SandboxVars.ParadiseZpvp.PvPInjuryChance) then
        if not pl:HasTrait('InjuredPvP') then
            pl:getTraits():add('InjuredPvP')
            pl:addLineChatElement('PvP Injured')
        end
    end

    if md.LifePoints <= 0 then
        if not SandboxVars.ParadiseZpvp.teleportPvpDeath then
            pl:Kill(pl)
        end
    end
end

function ParadiseZ._forEachLocalExplosionPlayer(func)
    if getNumActivePlayers then
        for i = 0, getNumActivePlayers() - 1 do
            local pl = getSpecificPlayer(i)
            if pl then func(pl) end
        end
    else
        local pl = getPlayer()
        if pl then func(pl) end
    end
end

function ParadiseZ.exploHandler(bomb, sq)
    if not bomb or not bomb.getObjectName or bomb:getObjectName() ~= "IsoTrap" then return end

    local dmg = 0
    if bomb.getExplosionPower then
        dmg = bomb:getExplosionPower() or 0
    end

    local rad = 0
    if bomb.getExplosionRange then
        rad = bomb:getExplosionRange() or 0
    end

    if sq and rad and rad > 0 then
        ParadiseZ._forEachLocalExplosionPlayer(function(pl)
            local checkDist = ParadiseZ.checkDist(pl, sq)
            if checkDist and checkDist <= rad then
                -- Block only vanilla player-body damage/injuries.  Do not zero the bomb's
                -- explosion power/range, because that also prevents vanilla zombie damage.
                local snap = ParadiseZ._snapshotExplosionHealth(pl)
                ParadiseZ._explosionProtectSerial = (ParadiseZ._explosionProtectSerial or 0) + 1
                local token = ParadiseZ._explosionProtectSerial
                pl:getModData().PZExplosionProtectToken = token
                pl:setAvoidDamage(true)
                ParadiseZ._restoreExplosionProtectionAfterTicks(pl, snap, 3, token)
                ParadiseZ._applyExplosionPvpDamage(pl, sq, dmg, rad)
            end
        end)
    end

    -- Keep the existing no-fire-zone behavior, but do not suppress explosion damage.
    if sq then
        local zName = ParadiseZ.getZoneName(sq)
        if zName and zName ~= tostring(SandboxVars.ParadiseZ.OutsideStr) then
            local zone = ParadiseZ.ZoneData[zName]
            if zone and zone.isNoFire then
                if bomb.setFirePower then bomb:setFirePower(0) end
                if bomb.setFireRange then bomb:setFireRange(0) end
            end
        end
    end
end
Events.OnThrowableExplode.Remove(ParadiseZ.exploHandler)
Events.OnThrowableExplode.Add(ParadiseZ.exploHandler)

